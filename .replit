modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "pango", "cairo", "expat", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libxshmfence", "mesa", "alsa-lib", "libxkbcommon", "libgbm"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "WhatsApp Cricket Bot"

[[workflows.workflow]]
name = "WhatsApp Cricket Bot"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node bot.js"

[workflows.workflow.metadata]
outputType = "console"
